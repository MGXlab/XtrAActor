// Nextflow configuration file

// Global default params
params {
    out_dir = 'output_dir_1'
}

// Process configuration
process {
    // Default settings
    executor = 'slurm'

    // Default resources
    cpus = 1
    memory = '4 GB'
    time = '1h'

    // Process-specific settings

    withName: MAFFT {
        cpus = 10
        memory = '50 GB'
        time = '6h'
        maxForks = 4
        errorStrategy = 'retry'
        maxRetries = 2
        queue = 'standard,short,long,fat'
    }

    withName: TRIMAL {
        cpus = 4
        memory = '10 GB'
        time = '1h'
        queue = 'standard,short,long,fat,gpu-veo'
    }

    withName: FASTTREE {
        cpus = 10
        memory = '50 GB'
        time = '6h'
        maxForks = 4
        errorStrategy = 'retry'
        maxRetries = 2
        queue = 'standard,short,long,fat'
    }

    withName: RF_MODEL {
        cpus = 30
        memory = '100 GB'
        time = '6h'
        errorStrategy = 'retry'
        maxRetries = 2
        queue = 'standard,short,long,fat,gpu-veo'
    }

    withName: CREATE_PHYLOGLM_DATASET {
        cpus = 10
        memory = '30 GB'
        time = '1h'
    }

    withName: SPLIT_GINI {
        cpus = 1
        memory = '5 GB'
        time = '30m'
    }

    withName: PHYLOGLM_FIT_CHUNK {
        cpus = 20
        memory = '80 GB'
        time = '4h'
        maxForks = 20
        errorStrategy = 'retry'
        maxRetries = 2
        queue = 'standard,short,long,fat'
    }

    withName: MERGE_PHYLOGLM {
        cpus = 4
        memory = '20 GB'
        time = '1h'
    }

    withName: PLOT_ZVALUE {
        cpus = 2
        memory = '10 GB'
        time = '1h'
    }

    withName: PLOTS {
        cpus = 10
        memory = '30 GB'
        time = '2h'
        errorStrategy = 'retry'
        maxRetries = 2
        queue = 'standard,short,long,fat'
    }
}

// Executor configuration
executor {
    name = 'slurm'
    queueSize = 20
    submitRateLimit = '10 sec'
}

// Report configuration
report {
    enabled = true
    file = "${params.out_dir}/nextflow_report.html"
}

timeline {
    enabled = true
    file = "${params.out_dir}/nextflow_timeline.html"
}

trace {
    enabled = true
    file = "${params.out_dir}/nextflow_trace.txt"
}

dag {
    enabled = true
    file = "${params.out_dir}/nextflow_dag.svg"
}