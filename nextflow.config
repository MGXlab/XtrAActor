process {
    executor = 'slurm'
    queue    = 'standard,short,long,fat,gpu-veo,gpu-test,gpu,interactive'

    // Defaults for any process without its own block
    cpus   = 1
    memory = '4 GB'
    time   = '1h'

    errorStrategy = 'retry'
    maxRetries    = 2

    // Upper bound for retry scaling — set to your largest node / partition limit
    resourceLimits = [cpus: 64, memory: 500.GB, time: 48.h]

    // ---------- genome -> clusters ----------
    withName: PHAROKKA {
        cpus     = 30
        memory   = { 64.GB * task.attempt }
        time     = { 12.h * task.attempt }
        maxForks = 10
    }

    withName: BAKTA {
        cpus     = 30
        memory   = { 64.GB * task.attempt }
        time     = { 12.h * task.attempt }
        maxForks = 10
    }
    withName: MMSEQ2_DEREP {
            cpus   = 10
            memory = { 50.GB * task.attempt }
            time   = { 6.h * task.attempt }
    }
    withName: MMSEQ2 {
        cpus   = 10
        memory = { 50.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: ORTHOGROUPS {
        cpus   = 2
        memory = { 20.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // ---------- cluster analysis ----------
    withName: MAFFT {
        cpus     = 30
        memory   = { 50.GB * task.attempt }
        time     = { 6.h * task.attempt }
        maxForks = 4
    }

    withName: TRIMAL {
        cpus   = 1
        memory = { 10.GB * task.attempt }
        time   = { 1.h * task.attempt }
        queue  = 'standard,short,long,fat,gpu-veo'
    }

    withName: FASTTREE {
        cpus     = 30
        memory   = { 50.GB * task.attempt }
        time     = { 6.h * task.attempt }
        maxForks = 4
    }

    withName: RF_MODEL {
        cpus   = 30
        memory = { 100.GB * task.attempt }
        time   = { 6.h * task.attempt }
        queue  = 'standard,short,long,fat,gpu-veo'
    }

    // ---------- phyloglm ----------
    withName: CREATE_PHYLOGLM_DATASET {
        cpus   = 2
        memory = { 30.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: SPLIT_GINI {
        cpus          = 1
        memory        = '2 GB'
        time          = '30m'
        errorStrategy = 'terminate'
    }

    withName: PHYLOGLM_FIT_CHUNK {
        cpus     = 20
        memory   = { 80.GB * task.attempt }
        time     = { 4.h * task.attempt }
        maxForks = 20
    }

    withName: MERGE_PHYLOGLM {
        cpus   = 1
        memory = { 20.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: PLOT_ZVALUE {
        cpus          = 1
        memory        = '10 GB'
        time          = '1h'
        errorStrategy = 'terminate'
    }

    // ---------- protein enrichment (pyseer) ----------
    // a failure in this branch does not stop the multi-biome analysis
    withName: 'ENRICH_INPUTS|TREE_SIMILARITY|PREP_GENOMES|VIPTREEGEN|MASH_DISTANCES|DIAMOND_MAKEDB|DIAMOND_BLASTP|SUM_BITSCORES|DICE_DISTANCES|PYSEER|ENRICHMENT_REPORT' {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
    }

    withName: ENRICH_INPUTS {
        cpus   = 1
        memory = { 30.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: TREE_SIMILARITY {
        cpus   = 1
        memory = { 30.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: VIPTREEGEN {
        cpus   = 30
        memory = { 60.GB * task.attempt }
        time   = { 24.h * task.attempt }
        queue  = 'standard,long,fat'
    }

    withName: MASH_DISTANCES {
        cpus   = 8
        memory = { 30.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: DIAMOND_MAKEDB {
        cpus   = 8
        memory = { 20.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: DIAMOND_BLASTP {
        cpus     = 20
        memory   = { 60.GB * task.attempt }
        time     = { 12.h * task.attempt }
        maxForks = 20
    }

    withName: SUM_BITSCORES {
        cpus     = 1
        memory   = { 16.GB * task.attempt }
        time     = { 2.h * task.attempt }
        maxForks = 20
    }

    withName: DICE_DISTANCES {
        cpus   = 2
        memory = { 60.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: PYSEER {
        cpus   = 8
        memory = { 60.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    // ---------- global plots ----------
    withName: PLOT_RF_REPORT {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: PLOT_CLUSTER {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        cpus     = 1
        memory   = { 16.GB * task.attempt }
        time     = { 1.h * task.attempt }
        maxForks = 20
    }

    withName: CLUSTER_PROPERTY_PLOTS {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // ---------- ranking the clusters ----------
        withName: RANK_CLUSTERS {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}
