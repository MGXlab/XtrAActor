process {
    executor = 'slurm'
    queue    = 'standard,short,long,fat'

    // Defaults for any process without its own block
    cpus   = 1
    memory = '4 GB'
    time   = '1h'

    errorStrategy = 'retry'
    maxRetries    = 2

    // Upper bound for retry scaling — set to your largest node / partition limit
    resourceLimits = [cpus: 64, memory: 500.GB, time: 48.h]

    // ---------- genome -> clusters ----------
    withName: PHAROKKA {
        cpus     = 30
        memory   = { 64.GB * task.attempt }
        time     = { 12.h * task.attempt }
        maxForks = 10
    }

    withName: BAKTA {
        cpus     = 30
        memory   = { 64.GB * task.attempt }
        time     = { 12.h * task.attempt }
        maxForks = 10
    }
    withName: MMSEQ2_DEREP {
            cpus   = 10
            memory = { 50.GB * task.attempt }
            time   = { 6.h * task.attempt }
    }
    withName: MMSEQ2 {
        cpus   = 10
        memory = { 50.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: ORTHOGROUPS {
        cpus   = 2
        memory = { 20.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // ---------- cluster analysis ----------
    withName: MAFFT {
        cpus     = 30
        memory   = { 50.GB * task.attempt }
        time     = { 6.h * task.attempt }
        maxForks = 4
    }

    withName: TRIMAL {
        cpus   = 1
        memory = { 10.GB * task.attempt }
        time   = { 1.h * task.attempt }
        queue  = 'standard,short,long,fat,gpu-veo'
    }

    withName: FASTTREE {
        cpus     = 30
        memory   = { 50.GB * task.attempt }
        time     = { 6.h * task.attempt }
        maxForks = 4
    }

    withName: RF_MODEL {
        cpus   = 30
        memory = { 100.GB * task.attempt }
        time   = { 6.h * task.attempt }
        queue  = 'standard,short,long,fat,gpu-veo'
    }

    // ---------- phyloglm ----------
    withName: CREATE_PHYLOGLM_DATASET {
        cpus   = 2
        memory = { 30.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: SPLIT_GINI {
        cpus          = 1
        memory        = '2 GB'
        time          = '30m'
        errorStrategy = 'terminate'
    }

    withName: PHYLOGLM_FIT_CHUNK {
        cpus     = 20
        memory   = { 80.GB * task.attempt }
        time     = { 4.h * task.attempt }
        maxForks = 20
    }

    withName: MERGE_PHYLOGLM {
        cpus   = 1
        memory = { 20.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: PLOT_ZVALUE {
        cpus          = 1
        memory        = '10 GB'
        time          = '1h'
        errorStrategy = 'terminate'
    }

    // ---------- single-biome cluster analysis ----------
    withName: DIAMOND_MAKEDB {
        cpus   = 8
        memory = { 20.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: DIAMOND_BLASTP {
        cpus     = 20
        memory   = { 60.GB * task.attempt }
        time     = { 12.h * task.attempt }
        maxForks = 20
    }

    // reads the whole all-v-all table into memory; neighbour joining is single-threaded and slow
    withName: DICE_TREE {
        cpus   = 2
        memory = { 100.GB * task.attempt }
        time   = { 24.h * task.attempt }
        queue  = 'standard,long,fat'
    }

    withName: SINGLE_BIOME_CLUSTERS {
        cpus   = 1
        memory = { 30.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: PHYLOGLM_SINGLE_BIOME {
        cpus     = 10
        memory   = { 40.GB * task.attempt }
        time     = { 4.h * task.attempt }
        maxForks = 20
    }

    withName: SINGLE_BIOME_REPORT {
        cpus   = 1
        memory = { 10.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // ---------- global plots ----------
    withName: PLOTS {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        cpus   = 4
        memory = { 30.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // ---------- ranking the clusters ----------
        withName: RANK_CLUSTERS {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}